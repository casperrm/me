{
  "name": "cedar-point-os",
  "private": true,
  "version": "0.1.0",
  "description": "Cedar Point OS — AI-native operating system for Cedar Point Media. See docs/CEDAR_POINT_OS_BIBLE.md.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev --workspace apps/web",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:generate": "npm run generate --workspace @cedar/db",
    "db:migrate": "npm run migrate --workspace @cedar/db",
    "db:migrate:deploy": "npm run migrate:deploy --workspace @cedar/db",
    "db:seed": "npm run seed --workspace @cedar/db",
    "db:studio": "npm run studio --workspace @cedar/db",
    "db:reset": "npm run reset --workspace @cedar/db",
    "test:e2e": "npm run db:reset && npx tsx scripts/reset-rate-limits.ts && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "otplib": "^12.0.1",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^2.1.9"
  }
}
