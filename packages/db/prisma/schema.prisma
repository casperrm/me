// Cedar Point OS — canonical relational schema.
//
// Authoritative source: docs/CEDAR_POINT_OS_BIBLE.md. Section references
// in comments below point at that document. PostgreSQL is the system of
// record (Section 27); nothing here should require an app-layer decision
// to already know a Client/Organization exists — every table that can be
// tenant- or client-scoped carries organizationId / clientId directly
// (Section 27.1) so authorization can filter at the query layer, not after
// the fact in application code.
//
// Identity is split into User (global person) and Membership (that
// person's role within one Organization) per Section 3's domain model —
// this is what makes "a user belongs to exactly one org" NOT an assumption
// baked into the schema, even though Phase 0 only exercises one org per
// user in practice.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity & Access (Bible Section 2, 27.2 "Identity" table group)
// ---------------------------------------------------------------------------

enum Role {
  OWNER
  ADMIN
  ACCOUNT_MANAGER
  ADS_MANAGER
  DESIGNER
  VIDEO_PRODUCTION
  FINANCE
  CLIENT_PORTAL
  CUSTOM
}

enum MembershipStatus {
  ACTIVE
  INVITED
  REVOKED
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
  invitations Invitation[]
  auditEvents AuditEvent[]
  clients     Client[]
  expenses    Expense[]
  assets      Asset[]

  @@map("organizations")
}

// Global person identity. Not org-scoped — org access is entirely through
// Membership, so one person can belong to multiple organizations later
// (e.g. a contractor working two agencies) without a schema change.
model User {
  id                 String   @id @default(uuid())
  email              String   @unique
  passwordHash       String
  name               String
  mfaEnabled         Boolean  @default(false)
  // AES-256-GCM ciphertext ("iv:authTag:ciphertext", hex) — see
  // packages/auth/src/mfa.ts. Set as soon as enrollment starts; only
  // `mfaEnabled` flips to true once the user proves possession of it by
  // submitting a valid code, so an abandoned enrollment attempt never
  // silently locks the account out.
  mfaSecretEncrypted String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  memberships      Membership[]
  sessions         Session[]
  meetings         MeetingAttendee[]
  mfaRecoveryCodes MfaRecoveryCode[]
  pendingMfaLogins PendingMfaLogin[]

  @@map("users")
}

// Section 23.1: "MFA for privileged users." One-time codes for when the
// authenticator device is unavailable — generated in a batch on
// enrollment (and on any later regeneration), shown to the user exactly
// once, and never stored in plaintext (same hash-then-compare pattern as
// Session/Invitation tokens).
model MfaRecoveryCode {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("mfa_recovery_codes")
}

// The gap between "password verified" and "session issued" for an
// MFA-enrolled user. Short-lived (5 minutes) and single-use — consumed
// the moment the TOTP/recovery-code challenge succeeds. Never holds
// anything more sensitive than a reference to whose login is pending;
// the password has already been verified by the time this row exists.
model PendingMfaLogin {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("pending_mfa_logins")
}

// A user's role within one organization. This — not User — is what
// authorization checks against (Section 2.2: role + org + client + action).
model Membership {
  id             String           @id @default(uuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id])
  userId         String
  user           User             @relation(fields: [userId], references: [id])
  role           Role
  status         MembershipStatus @default(ACTIVE)
  invitedById    String?
  invitedBy      Membership?      @relation("MembershipInvitedBy", fields: [invitedById], references: [id])
  invitedOthers  Membership[]     @relation("MembershipInvitedBy")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  version        Int              @default(1) // optimistic concurrency (Section 27.1)

  scopedGrants              ScopedGrant[]
  assignedTasks             Task[]
  invitationsSent           Invitation[]          @relation("InvitationInvitedBy")
  uploadedAssets            Asset[]
  ownedContentCalendarItems ContentCalendarItem[]

  @@unique([organizationId, userId])
  @@index([organizationId, role])
  @@map("memberships")
}

// Invite-only access (Section 2.1 / 29 in the earlier vision). A Membership
// row is only created once the invitation is accepted.
model Invitation {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  email          String
  role           Role
  // Pre-scopes the invite to one client — required in practice for
  // CLIENT_PORTAL invites (Section 15.2: a client contact must never end
  // up with zero client access), optional for internal roles. On
  // acceptance, a CLIENT_PORTAL invite with a clientId auto-creates the
  // ScopedGrant(s) that make the portal usable immediately — see
  // acceptInvitationFlow.
  clientId       String?
  client         Client?      @relation(fields: [clientId], references: [id])
  tokenHash      String       @unique
  invitedById    String
  invitedBy      Membership   @relation("InvitationInvitedBy", fields: [invitedById], references: [id])
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime     @default(now())

  @@index([organizationId, email])
  @@map("invitations")
}

// Server-side session (Section 23.1: secure session lifecycle, device
// revocation). tokenHash stores a hash of the bearer token, never the
// token itself — see ADR-006.
model Session {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  ipAddress String?
  userAgent String?

  @@index([userId])
  @@map("sessions")
}

// Contextual permission beyond a role's default set — e.g. an
// ACCOUNT_MANAGER scoped to only certain clients, or the entire permission
// set for a CUSTOM role. Absence of a clientId means "organization-wide"
// for that permission. See packages/domain for the permission catalog and
// ADR-006 for why this is code-defined defaults + DB-backed exceptions
// rather than a fully data-driven role_permissions table (deferred until
// an admin-configurable policy builder is actually needed — Section 37).
model ScopedGrant {
  id           String     @id @default(uuid())
  membershipId String
  membership   Membership @relation(fields: [membershipId], references: [id])
  permission   String
  clientId     String?
  client       Client?    @relation(fields: [clientId], references: [id])
  createdAt    DateTime   @default(now())
  createdBy    String?

  @@index([membershipId])
  @@index([clientId])
  @@map("scoped_grants")
}

// ---------------------------------------------------------------------------
// Audit & Governance (Section 23.2 — minimum schema quoted directly)
// ---------------------------------------------------------------------------

enum AuditActorType {
  USER
  SYSTEM
  AI_AGENT
}

enum AuditResult {
  SUCCESS
  FAILURE
  DENIED
}

// Append-only by convention: application code must never UPDATE or DELETE
// a row here (Section 27.1, "Audit records are append-oriented and
// protected from ordinary mutation"). packages/events is the only writer.
model AuditEvent {
  id             String         @id @default(uuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id])
  actorType      AuditActorType
  actorId        String? // Membership id for USER, agent name for AI_AGENT, null for SYSTEM
  action         String // e.g. "membership.role_changed", "invitation.accepted"
  resourceType   String
  resourceId     String
  clientId       String?
  timestamp      DateTime       @default(now())
  correlationId  String?
  sourceIp       String?
  deviceMetadata String? // JSON
  changeSet      String? // JSON: before/after summary, redacted of secrets
  approvalId     String? // reserved for when the Approval model lands (Phase 2)
  result         AuditResult
  integrityHash  String? // sha256(prevHash + payload) — lightweight tamper-evidence chain, see ADR-006

  @@index([organizationId, resourceType, resourceId])
  @@index([organizationId, timestamp])
  @@map("audit_events")
}

// ---------------------------------------------------------------------------
// Clients & CRM (Section 4). Phase 0 needs enough of this to write
// meaningful authorization tests (Section 38: "collaborator cannot access
// unauthorized clients"); the rest of Section 4/5's richer client
// operating system content below is genuinely Phase 1+ but is included now
// because it was already built and maps directly onto Section 3's domain
// model — it stays inert (unreachable without a Membership + permission)
// until Phase 1 UI work exposes it.
// ---------------------------------------------------------------------------

model Client {
  id                  String       @id @default(uuid())
  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id])
  name                String
  companyName         String
  industry            String?
  lifecycleStage      String       @default("ACTIVE") // PROSPECT | ACTIVE | PAUSED | CHURNED
  services            String // JSON array
  primaryContactName  String?
  primaryContactEmail String?
  connectedAccounts   String? // JSON: [{ platform, accountId, status }]
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  brandProfile         BrandProfile?
  projects             Project[]
  invoices             Invoice[]
  notes                Note[]
  meetings             Meeting[]
  timelineEvents       ClientTimelineEvent[]
  healthScores         ClientHealthScore[]
  scopedGrants         ScopedGrant[]
  assets               Asset[]
  invitations          Invitation[]
  contentCalendarItems ContentCalendarItem[]
  shoots               Shoot[]

  @@index([organizationId])
  @@map("clients")
}

// Section 5: Brand DNA, versioned. Renamed from the earlier "BrandDNA" to
// match Section 3's "BrandProfile" domain entity name; versioning is a
// separate table so historical creative can be evaluated against the
// rules active when it was created (Section 5, first line).
model BrandProfile {
  id       String @id @default(uuid())
  clientId String @unique
  client   Client @relation(fields: [clientId], references: [id])

  currentVersion Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions BrandProfileVersion[]

  @@map("brand_profiles")
}

model BrandProfileVersion {
  id                  String       @id @default(uuid())
  brandProfileId      String
  brandProfile        BrandProfile @relation(fields: [brandProfileId], references: [id])
  version             Int
  colors              String? // JSON: [{ name, hex }]
  fonts               String? // JSON: [{ role, family }]
  logoAssetIds        String? // JSON array of Asset ids
  toneOfVoice         String?
  visualStyle         String?
  targetAudience      String?
  products            String? // JSON array
  approvedPatterns    String? // JSON, with rationale (Section 5)
  rejectedPatterns    String? // JSON, with rationale (Section 5)
  // Section 5's "prohibited language ... claims, disclaimers" — the
  // inputs Quality Control (Section 5/6.1/7) actually checks creative
  // text against before client review. See qc-service.ts.
  prohibitedLanguage  String? // JSON array of strings
  requiredDisclaimers String? // JSON array of strings
  createdAt           DateTime     @default(now())
  createdBy           String? // Membership id

  @@unique([brandProfileId, version])
  @@map("brand_profile_versions")
}

model ClientTimelineEvent {
  id         String   @id @default(uuid())
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id])
  type       String
  summary    String
  metadata   String? // JSON
  occurredAt DateTime @default(now())

  @@index([clientId, occurredAt])
  @@map("client_timeline_events")
}

model ClientHealthScore {
  id         String   @id @default(uuid())
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id])
  score      Int
  factors    String? // JSON — explainable signals per Section 4.2
  computedAt DateTime @default(now())

  @@map("client_health_scores")
}

model Note {
  id        String   @id @default(uuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id])
  body      String
  createdAt DateTime @default(now())

  @@map("notes")
}

// ---------------------------------------------------------------------------
// Projects, Tasks, Campaigns, Creatives (Sections 8, 10-12)
// ---------------------------------------------------------------------------

model Project {
  id        String    @id @default(uuid())
  clientId  String
  client    Client    @relation(fields: [clientId], references: [id])
  name      String
  status    String    @default("PLANNING") // PLANNING | IN_PROGRESS | IN_REVIEW | DELIVERED | ARCHIVED
  dueDate   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tasks     Task[]
  campaigns Campaign[]
  assets    Asset[]
  shoots    Shoot[]

  @@map("projects")
}

model Task {
  id         String      @id @default(uuid())
  projectId  String
  project    Project     @relation(fields: [projectId], references: [id])
  title      String
  status     String      @default("todo")
  assigneeId String?
  assignee   Membership? @relation(fields: [assigneeId], references: [id])
  dueDate    DateTime?
  createdAt  DateTime    @default(now())

  @@map("tasks")
}

model Campaign {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])
  name        String
  objective   String?
  status      String   @default("DRAFT") // DRAFT | PENDING_APPROVAL | ACTIVE | PAUSED | COMPLETED
  platform    String?
  externalId  String?
  budgetCents Int?
  kpis        String? // JSON
  createdAt   DateTime @default(now())

  creatives            Creative[]
  contentCalendarItems ContentCalendarItem[]

  @@map("campaigns")
}

model Creative {
  id             String   @id @default(uuid())
  campaignId     String
  campaign       Campaign @relation(fields: [campaignId], references: [id])
  type           String
  platform       String?
  status         String   @default("DRAFT") // DRAFT | PENDING_APPROVAL | APPROVED | REJECTED
  currentVersion Int      @default(1)
  createdAt      DateTime @default(now())

  versions             CreativeVersion[]
  assets               Asset[]
  contentCalendarItems ContentCalendarItem[]
  videoBrief           VideoBrief?

  @@map("creatives")
}

// ---------------------------------------------------------------------------
// AI Video Studio (Section 11.1). Pre-production planning for a video
// creative — concept, hook, storyboard, script, shot plan, voice-over
// copy, subtitle/caption copy, edit instructions, music/asset notes, and
// platform variants. Versioned the same way Brand DNA is (Section 5):
// a save always inserts a new VideoBriefVersion rather than mutating the
// latest one, "so historical creative can be evaluated against the plan
// active when it was made." The eventual final video file, its approval,
// and its publishing all go through the existing Creative/CreativeVersion/
// Approval pipeline (Section 15.1) — this model is 1:1 with a Creative
// and only covers the planning stage, not a parallel approval flow.
model VideoBrief {
  id             String   @id @default(uuid())
  creativeId     String   @unique
  creative       Creative @relation(fields: [creativeId], references: [id])
  currentVersion Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  versions VideoBriefVersion[]

  @@map("video_briefs")
}

model VideoBriefVersion {
  id               String     @id @default(uuid())
  videoBriefId     String
  videoBrief       VideoBrief @relation(fields: [videoBriefId], references: [id])
  version          Int
  concept          String?
  hook             String?
  storyboardNotes  String?
  script           String?
  voiceoverCopy    String?
  captionCopy      String?
  editInstructions String?
  musicNotes       String?
  platformVariants String? // JSON array, e.g. ["9:16","1:1","16:9"]
  createdAt        DateTime   @default(now())
  createdBy        String? // Membership id

  @@unique([videoBriefId, version])
  @@map("video_brief_versions")
}

// ---------------------------------------------------------------------------
// Photography / Production Module (Section 11.2): shoot schedule,
// locations, contacts, crew, roles, equipment, permits/requirements, call
// sheet, shot list, product list, references, status. Kept as one table
// with JSON columns for the list-shaped fields (crew/equipment/shot
// list/product list/references) rather than a table per list — same
// pragmatic choice already made for Client.services and
// BrandProfileVersion's colors/fonts/patterns; promote to real tables
// if/when this needs relational querying (e.g. "find every shoot needing
// a specific crew member").
model Shoot {
  id             String    @id @default(uuid())
  clientId       String
  client         Client    @relation(fields: [clientId], references: [id])
  projectId      String?
  project        Project?  @relation(fields: [projectId], references: [id])
  title          String
  status         String    @default("PLANNED") // PLANNED | CONFIRMED | COMPLETED | CANCELED
  scheduledAt    DateTime?
  location       String?
  crew           String? // JSON: [{ name, role, contact }]
  equipment      String? // JSON array of strings
  permits        String? // JSON array of strings
  callSheetNotes String?
  shotList       String? // JSON: [{ description, status }]
  productList    String? // JSON array of strings
  references     String? // JSON array of strings
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([clientId])
  @@map("shoots")
}

model CreativeVersion {
  id         String   @id @default(uuid())
  creativeId String
  creative   Creative @relation(fields: [creativeId], references: [id])
  version    Int
  assetId    String?
  asset      Asset?   @relation(fields: [assetId], references: [id])
  notes      String?
  createdAt  DateTime @default(now())

  approvals           Approval[]
  qualityCheckResults QualityCheckResult[]

  @@map("creative_versions")
}

model Approval {
  id                String          @id @default(uuid())
  creativeVersionId String
  creativeVersion   CreativeVersion @relation(fields: [creativeVersionId], references: [id])
  decision          String // requested | changes_requested | approved | superseded | canceled (Section 15.1)
  comment           String?
  decidedBy         String?
  createdAt         DateTime        @default(now())

  @@map("approvals")
}

// Quality Control (Section 5: "Quality Control checks outputs for brand
// consistency, spelling/language, required information, dimensions/
// specifications, and obvious inconsistencies before client review";
// Section 6.1/7 name this "Quality Control AI" in the orchestrated flow).
// Run automatically by requestApproval — see qc-service.ts for what each
// check actually does and the explicit scope boundary (deterministic
// rule checks against Brand DNA + platform dimension specs, not an LLM
// judgment call — no AI Foundation wiring exists yet for that, Phase 3).
// Advisory, not a hard gate: a FAIL still lets the request through, but
// is impossible to miss in the UI, matching "before client review"
// rather than "instead of client review."
model QualityCheckResult {
  id                String          @id @default(uuid())
  creativeVersionId String
  creativeVersion   CreativeVersion @relation(fields: [creativeVersionId], references: [id])
  overallStatus     String // pass | warning | fail
  checks            String // JSON: [{ name, status, message }]
  createdAt         DateTime        @default(now())

  @@map("quality_check_results")
}

// ---------------------------------------------------------------------------
// Content Planning and Publishing (Section 9). This is the planning/
// scheduling layer — "content calendar with client, channel, campaign,
// content pillar, format, owner, status, due date, approval, publish
// time, and linked assets" — distinct from Section 12's due-date
// calendar (packages/db already backs that one from Task/Project/Invoice
// due dates directly). Approval itself is NOT reimplemented here: a
// content item optionally points at a Creative, which already carries
// the full Section 15.1 approval state machine — this model only tracks
// the item's own planning-stage status.
//
// `status` follows Section 9's workflow (brief -> draft -> internal
// review -> client approval when required -> scheduled/ready -> publish
// -> performance -> learning) as far as this phase can actually go:
// BRIEF | DRAFT | INTERNAL_REVIEW | CLIENT_APPROVAL | SCHEDULED |
// PUBLISHED | FAILED. "Publish" here means "marked scheduled/published in
// the plan," not an authorized connector call — real publish execution
// needs the Integration Center (Phase 4, ADR-pending: no real platform
// credentials exist yet). FAILED preserves `failureReason` for the
// "actionable alerts, preserve payload/error metadata, safe retry"
// requirement, in the one form buildable without a real connector.
model ContentCalendarItem {
  id            String      @id @default(uuid())
  clientId      String
  client        Client      @relation(fields: [clientId], references: [id])
  campaignId    String?
  campaign      Campaign?   @relation(fields: [campaignId], references: [id])
  creativeId    String?
  creative      Creative?   @relation(fields: [creativeId], references: [id])
  channel       String // e.g. instagram, tiktok, meta, email, blog
  contentPillar String?
  format        String? // e.g. reel, carousel, static, story, article
  title         String
  status        String      @default("BRIEF")
  ownerId       String?
  owner         Membership? @relation(fields: [ownerId], references: [id])
  dueDate       DateTime?
  publishAt     DateTime?
  failureReason String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([clientId])
  @@map("content_calendar_items")
}

// Files & Smart Asset Manager (Section 14). `storageKey` is the
// backend-specific reference (see apps/web/src/lib/storage — a local
// filesystem adapter today, S3-compatible in production per ADR-005);
// application code should never construct a public URL from it directly,
// always go through the storage adapter's signed-URL method so swapping
// backends doesn't require touching every call site. Every asset is
// organization-scoped (and usually client-scoped) so authorization can
// filter at the query layer like everything else in this schema.
model Asset {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  clientId       String?
  client         Client?      @relation(fields: [clientId], references: [id])
  projectId      String?
  project        Project?     @relation(fields: [projectId], references: [id])
  creativeId     String?
  creative       Creative?    @relation(fields: [creativeId], references: [id])
  type           String // image | video | document | logo | font
  filename       String
  contentType    String?
  sizeBytes      Int?
  checksum       String? // sha256 of the file content — integrity + de-dupe
  storageKey     String // backend-specific key/path
  status         String       @default("AVAILABLE") // PENDING_SCAN | AVAILABLE | REJECTED — see ADR-005 for why virus scanning isn't wired to this yet
  version        Int          @default(1)
  uploadedById   String?
  uploadedBy     Membership?  @relation(fields: [uploadedById], references: [id])
  createdAt      DateTime     @default(now())

  creativeVersions CreativeVersion[]

  @@index([organizationId])
  @@index([clientId])
  @@map("assets")
}

// ---------------------------------------------------------------------------
// Finance (Section 16)
// ---------------------------------------------------------------------------

model Invoice {
  id          String    @id @default(uuid())
  clientId    String
  client      Client    @relation(fields: [clientId], references: [id])
  amountCents Int
  currency    String    @default("USD")
  status      String    @default("DRAFT") // DRAFT | SENT | PAID | OVERDUE | FAILED
  issuedAt    DateTime  @default(now())
  dueAt       DateTime?
  paidAt      DateTime?

  @@map("invoices")
}

model Expense {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  category       String
  amountCents    Int
  description    String?
  incurredAt     DateTime     @default(now())

  @@map("expenses")
}

// ---------------------------------------------------------------------------
// Meetings (Section 13)
// ---------------------------------------------------------------------------

model Meeting {
  id         String   @id @default(uuid())
  clientId   String?
  client     Client?  @relation(fields: [clientId], references: [id])
  title      String
  notes      String?
  decisions  String? // JSON
  followUps  String? // JSON
  occurredAt DateTime @default(now())

  attendees MeetingAttendee[]

  @@map("meetings")
}

model MeetingAttendee {
  id        String  @id @default(uuid())
  meetingId String
  meeting   Meeting @relation(fields: [meetingId], references: [id])
  userId    String
  user      User    @relation(fields: [userId], references: [id])

  @@map("meeting_attendees")
}

// ---------------------------------------------------------------------------
// Cedar Brain (Section 6-7): every command logged for Agency Memory.
// ---------------------------------------------------------------------------

model CedarBrainRequest {
  id             String   @id @default(uuid())
  organizationId String
  prompt         String
  routedAgents   String // JSON array
  response       String? // JSON
  clientId       String?
  createdAt      DateTime @default(now())

  @@map("cedar_brain_requests")
}
