// Cedar Point OS — canonical relational schema.
//
// Authoritative source: docs/CEDAR_POINT_OS_BIBLE.md. Section references
// in comments below point at that document. PostgreSQL is the system of
// record (Section 27); nothing here should require an app-layer decision
// to already know a Client/Organization exists — every table that can be
// tenant- or client-scoped carries organizationId / clientId directly
// (Section 27.1) so authorization can filter at the query layer, not after
// the fact in application code.
//
// Identity is split into User (global person) and Membership (that
// person's role within one Organization) per Section 3's domain model —
// this is what makes "a user belongs to exactly one org" NOT an assumption
// baked into the schema, even though Phase 0 only exercises one org per
// user in practice.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity & Access (Bible Section 2, 27.2 "Identity" table group)
// ---------------------------------------------------------------------------

enum Role {
  OWNER
  ADMIN
  ACCOUNT_MANAGER
  ADS_MANAGER
  DESIGNER
  VIDEO_PRODUCTION
  FINANCE
  CLIENT_PORTAL
  CUSTOM
}

enum MembershipStatus {
  ACTIVE
  INVITED
  REVOKED
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // Section 23.1 "MFA for privileged users" — the enforcement half
  // docs/specs/mfa.md's original scope boundary named as not yet built.
  // Off by default (no existing organization is silently locked out);
  // an owner/admin opts in from /team. Only OWNER/ADMIN membership roles
  // are "privileged" for this gate — see mfa-policy-service.ts.
  mfaRequiredForPrivilegedRoles Boolean @default(false)

  memberships      Membership[]
  invitations      Invitation[]
  auditEvents      AuditEvent[]
  clients          Client[]
  expenses         Expense[]
  assets           Asset[]
  notifications    Notification[]
  connections      Connection[]
  aiBudget         AiBudget?
  projectTemplates ProjectTemplate[]

  @@map("organizations")
}

// Global person identity. Not org-scoped — org access is entirely through
// Membership, so one person can belong to multiple organizations later
// (e.g. a contractor working two agencies) without a schema change.
model User {
  id                 String   @id @default(uuid())
  email              String   @unique
  passwordHash       String
  name               String
  mfaEnabled         Boolean  @default(false)
  // AES-256-GCM ciphertext ("iv:authTag:ciphertext", hex) — see
  // packages/auth/src/mfa.ts. Set as soon as enrollment starts; only
  // `mfaEnabled` flips to true once the user proves possession of it by
  // submitting a valid code, so an abandoned enrollment attempt never
  // silently locks the account out.
  mfaSecretEncrypted String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  memberships      Membership[]
  sessions         Session[]
  meetings         MeetingAttendee[]
  mfaRecoveryCodes MfaRecoveryCode[]
  pendingMfaLogins PendingMfaLogin[]

  @@map("users")
}

// Section 23.1: "MFA for privileged users." One-time codes for when the
// authenticator device is unavailable — generated in a batch on
// enrollment (and on any later regeneration), shown to the user exactly
// once, and never stored in plaintext (same hash-then-compare pattern as
// Session/Invitation tokens).
model MfaRecoveryCode {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("mfa_recovery_codes")
}

// The gap between "password verified" and "session issued" for an
// MFA-enrolled user. Short-lived (5 minutes) and single-use — consumed
// the moment the TOTP/recovery-code challenge succeeds. Never holds
// anything more sensitive than a reference to whose login is pending;
// the password has already been verified by the time this row exists.
model PendingMfaLogin {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("pending_mfa_logins")
}

// A user's role within one organization. This — not User — is what
// authorization checks against (Section 2.2: role + org + client + action).
model Membership {
  id             String           @id @default(uuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id])
  userId         String
  user           User             @relation(fields: [userId], references: [id])
  role           Role
  status         MembershipStatus @default(ACTIVE)
  invitedById    String?
  invitedBy      Membership?      @relation("MembershipInvitedBy", fields: [invitedById], references: [id])
  invitedOthers  Membership[]     @relation("MembershipInvitedBy")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  version        Int              @default(1) // optimistic concurrency (Section 27.1)

  scopedGrants              ScopedGrant[]
  assignedTasks             Task[]
  taskComments              TaskComment[]
  invitationsSent           Invitation[]          @relation("InvitationInvitedBy")
  uploadedAssets            Asset[]
  ownedContentCalendarItems ContentCalendarItem[]
  notifications             Notification[]
  flaggedCedarBrainRequests CedarBrainRequest[]
  createdConnections        Connection[]

  @@unique([organizationId, userId])
  @@index([organizationId, role])
  @@map("memberships")
}

// Invite-only access (Section 2.1 / 29 in the earlier vision). A Membership
// row is only created once the invitation is accepted.
model Invitation {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  email          String
  role           Role
  // Pre-scopes the invite to one client — required in practice for
  // CLIENT_PORTAL invites (Section 15.2: a client contact must never end
  // up with zero client access), optional for internal roles. On
  // acceptance, a CLIENT_PORTAL invite with a clientId auto-creates the
  // ScopedGrant(s) that make the portal usable immediately — see
  // acceptInvitationFlow.
  clientId       String?
  client         Client?      @relation(fields: [clientId], references: [id])
  tokenHash      String       @unique
  invitedById    String
  invitedBy      Membership   @relation("InvitationInvitedBy", fields: [invitedById], references: [id])
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime     @default(now())

  @@index([organizationId, email])
  @@map("invitations")
}

// Server-side session (Section 23.1: secure session lifecycle, device
// revocation). tokenHash stores a hash of the bearer token, never the
// token itself — see ADR-006.
model Session {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  ipAddress String?
  userAgent String?

  @@index([userId])
  @@map("sessions")
}

// Contextual permission beyond a role's default set — e.g. an
// ACCOUNT_MANAGER scoped to only certain clients, or the entire permission
// set for a CUSTOM role. Absence of a clientId means "organization-wide"
// for that permission. See packages/domain for the permission catalog and
// ADR-006 for why this is code-defined defaults + DB-backed exceptions
// rather than a fully data-driven role_permissions table (deferred until
// an admin-configurable policy builder is actually needed — Section 37).
model ScopedGrant {
  id           String     @id @default(uuid())
  membershipId String
  membership   Membership @relation(fields: [membershipId], references: [id])
  permission   String
  clientId     String?
  client       Client?    @relation(fields: [clientId], references: [id])
  createdAt    DateTime   @default(now())
  createdBy    String?

  @@index([membershipId])
  @@index([clientId])
  @@map("scoped_grants")
}

// ---------------------------------------------------------------------------
// Audit & Governance (Section 23.2 — minimum schema quoted directly)
// ---------------------------------------------------------------------------

enum AuditActorType {
  USER
  SYSTEM
  AI_AGENT
}

enum AuditResult {
  SUCCESS
  FAILURE
  DENIED
}

// Append-only by convention: application code must never UPDATE or DELETE
// a row here (Section 27.1, "Audit records are append-oriented and
// protected from ordinary mutation"). packages/events is the only writer.
model AuditEvent {
  id             String         @id @default(uuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id])
  actorType      AuditActorType
  actorId        String? // Membership id for USER, agent name for AI_AGENT, null for SYSTEM
  action         String // e.g. "membership.role_changed", "invitation.accepted"
  resourceType   String
  resourceId     String
  clientId       String?
  timestamp      DateTime       @default(now())
  correlationId  String?
  sourceIp       String?
  deviceMetadata String? // JSON
  changeSet      String? // JSON: before/after summary, redacted of secrets
  approvalId     String? // reserved for when the Approval model lands (Phase 2)
  result         AuditResult
  integrityHash  String? // sha256(prevHash + payload) — lightweight tamper-evidence chain, see ADR-006

  @@index([organizationId, resourceType, resourceId])
  @@index([organizationId, timestamp])
  @@map("audit_events")
}

// ---------------------------------------------------------------------------
// Clients & CRM (Section 4). Phase 0 needs enough of this to write
// meaningful authorization tests (Section 38: "collaborator cannot access
// unauthorized clients"); the rest of Section 4/5's richer client
// operating system content below is genuinely Phase 1+ but is included now
// because it was already built and maps directly onto Section 3's domain
// model — it stays inert (unreachable without a Membership + permission)
// until Phase 1 UI work exposes it.
// ---------------------------------------------------------------------------

model Client {
  id                  String       @id @default(uuid())
  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id])
  name                String
  companyName         String
  industry            String?
  lifecycleStage      String       @default("ACTIVE") // PROSPECT | ACTIVE | PAUSED | CHURNED
  services            String // JSON array
  primaryContactName  String?
  primaryContactEmail String?
  connectedAccounts   String? // JSON: [{ platform, accountId, status }]
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  brandProfile         BrandProfile?
  projects             Project[]
  invoices             Invoice[]
  notes                Note[]
  meetings             Meeting[]
  timelineEvents       ClientTimelineEvent[]
  healthScores         ClientHealthScore[]
  scopedGrants         ScopedGrant[]
  assets               Asset[]
  invitations          Invitation[]
  contentCalendarItems ContentCalendarItem[]
  shoots               Shoot[]
  notifications        Notification[]
  expenses             Expense[]

  @@index([organizationId])
  @@map("clients")
}

// Section 5: Brand DNA, versioned. Renamed from the earlier "BrandDNA" to
// match Section 3's "BrandProfile" domain entity name; versioning is a
// separate table so historical creative can be evaluated against the
// rules active when it was created (Section 5, first line).
model BrandProfile {
  id       String @id @default(uuid())
  clientId String @unique
  client   Client @relation(fields: [clientId], references: [id])

  currentVersion Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions BrandProfileVersion[]

  @@map("brand_profiles")
}

model BrandProfileVersion {
  id                  String       @id @default(uuid())
  brandProfileId      String
  brandProfile        BrandProfile @relation(fields: [brandProfileId], references: [id])
  version             Int
  colors              String? // JSON: [{ name, hex }]
  fonts               String? // JSON: [{ role, family }]
  logoAssetIds        String? // JSON array of Asset ids
  toneOfVoice         String?
  visualStyle         String?
  targetAudience      String?
  products            String? // JSON array
  approvedPatterns    String? // JSON, with rationale (Section 5)
  rejectedPatterns    String? // JSON, with rationale (Section 5)
  // Section 5's "prohibited language ... claims, disclaimers" — the
  // inputs Quality Control (Section 5/6.1/7) actually checks creative
  // text against before client review. See qc-service.ts.
  prohibitedLanguage  String? // JSON array of strings
  requiredDisclaimers String? // JSON array of strings
  createdAt           DateTime     @default(now())
  createdBy           String? // Membership id

  @@unique([brandProfileId, version])
  @@map("brand_profile_versions")
}

model ClientTimelineEvent {
  id         String   @id @default(uuid())
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id])
  type       String
  summary    String
  metadata   String? // JSON
  occurredAt DateTime @default(now())

  @@index([clientId, occurredAt])
  @@map("client_timeline_events")
}

model ClientHealthScore {
  id         String   @id @default(uuid())
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id])
  score      Int
  factors    String? // JSON — explainable signals per Section 4.2
  computedAt DateTime @default(now())

  @@map("client_health_scores")
}

model Note {
  id        String   @id @default(uuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id])
  body      String
  createdAt DateTime @default(now())

  @@map("notes")
}

// ---------------------------------------------------------------------------
// Projects, Tasks, Campaigns, Creatives (Sections 8, 10-12)
// ---------------------------------------------------------------------------

model Project {
  id        String    @id @default(uuid())
  clientId  String
  client    Client    @relation(fields: [clientId], references: [id])
  name      String
  status    String    @default("PLANNING") // PLANNING | IN_PROGRESS | IN_REVIEW | DELIVERED | ARCHIVED
  dueDate   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tasks      Task[]
  campaigns  Campaign[]
  assets     Asset[]
  shoots     Shoot[]
  invoices   Invoice[]
  expenses   Expense[]
  milestones Milestone[]

  @@map("projects")
}

// Section 12's "milestones... with overdue/risk signals" — the smallest
// real cut of that gap: a named deadline on a project, independently
// markable done, with "overdue" computed as `!done && dueDate < now`
// rather than stored (a stored status would drift the moment "now"
// moves past `dueDate` without a write happening). No dependency graph
// between milestones — only tasks can declare a `TaskDependency` — see
// docs/specs/projects-and-calendar.md for the scope boundary.
model Milestone {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  name      String
  dueDate   DateTime
  done      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([projectId])
  @@map("milestones")
}

model Task {
  id            String      @id @default(uuid())
  projectId     String
  project       Project     @relation(fields: [projectId], references: [id])
  title         String
  status        String      @default("todo")
  priority      String      @default("medium") // low | medium | high — see docs/specs/projects-and-calendar.md
  assigneeId    String?
  assignee      Membership? @relation(fields: [assigneeId], references: [id])
  dueDate       DateTime?
  estimateHours Float?
  createdAt     DateTime    @default(now())

  checklistItems TaskChecklistItem[]
  comments       TaskComment[]
  attachments    Asset[]
  blockedBy      TaskDependency[]    @relation("TaskBlockedBy")
  blocking       TaskDependency[]    @relation("TaskBlocks")

  @@map("tasks")
}

// Section 12's "task dependencies" — the smallest real cut: a task can
// declare it is blocked by another task in the same project. Surfaced as
// a "Blocked by: X" indicator, and enforced as a hard rule (not just a
// warning) in `setTaskStatus`: a task cannot transition to "done" while
// any of its blockers is not yet "done". No dependency graph/critical-path
// engine, no cycle detection beyond rejecting a direct self-reference or
// duplicate pair — see docs/specs/projects-and-calendar.md for the scope
// boundary.
model TaskDependency {
  id              String   @id @default(uuid())
  taskId          String
  task            Task     @relation("TaskBlockedBy", fields: [taskId], references: [id])
  blockedByTaskId String
  blockedByTask   Task     @relation("TaskBlocks", fields: [blockedByTaskId], references: [id])
  createdAt       DateTime @default(now())

  @@unique([taskId, blockedByTaskId])
  @@index([taskId])
  @@index([blockedByTaskId])
  @@map("task_dependencies")
}

// Section 12's "reusable project templates" — the smallest real cut:
// a template is a saved snapshot of one project's task titles and
// priorities, org-wide (not tied to the client it was captured from),
// instantiated into a brand-new Project + Tasks. No milestones, no
// checklist items, no dependencies, no due-date offsets captured — see
// docs/specs/projects-and-calendar.md for the scope boundary.
model ProjectTemplate {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  createdAt      DateTime     @default(now())

  tasks ProjectTemplateTask[]

  @@index([organizationId])
  @@map("project_templates")
}

model ProjectTemplateTask {
  id         String          @id @default(uuid())
  templateId String
  template   ProjectTemplate @relation(fields: [templateId], references: [id])
  title      String
  priority   String          @default("medium") // low | medium | high — same convention as Task.priority
  position   Int
  createdAt  DateTime        @default(now())

  @@index([templateId])
  @@map("project_template_tasks")
}

// Section 12's "task... checklist" — the smallest real cut of that gap:
// a flat, ordered list of sub-items on a task, each independently
// checkable. No nesting, no per-item assignee/due date — see
// docs/specs/projects-and-calendar.md for what's still deliberately not
// built (a real dependency graph/critical-path engine, template
// editing).
model TaskChecklistItem {
  id        String   @id @default(uuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id])
  text      String
  done      Boolean  @default(false)
  position  Int
  createdAt DateTime @default(now())

  @@index([taskId])
  @@map("task_checklist_items")
}

// Section 12's "task... comments" — a flat, append-only conversation log
// on a task, each entry attributed to the org member who wrote it. No
// edit/delete (a comment is a permanent record, unlike a checklist item),
// no threading/replies — see docs/specs/projects-and-calendar.md for what
// is still deliberately not built (milestones/dependencies, attachments,
// templates).
model TaskComment {
  id        String     @id @default(uuid())
  taskId    String
  task      Task       @relation(fields: [taskId], references: [id])
  authorId  String
  author    Membership @relation(fields: [authorId], references: [id])
  text      String
  createdAt DateTime   @default(now())

  @@index([taskId])
  @@map("task_comments")
}

model Campaign {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])
  name        String
  objective   String?
  status      String   @default("DRAFT") // DRAFT | PENDING_APPROVAL | ACTIVE | PAUSED | COMPLETED
  platform    String?
  externalId  String?
  budgetCents Int?
  kpis        String? // JSON
  createdAt   DateTime @default(now())

  creatives            Creative[]
  contentCalendarItems ContentCalendarItem[]
  expenses             Expense[]

  @@map("campaigns")
}

model Creative {
  id             String   @id @default(uuid())
  campaignId     String
  campaign       Campaign @relation(fields: [campaignId], references: [id])
  type           String
  platform       String?
  status         String   @default("DRAFT") // DRAFT | PENDING_APPROVAL | APPROVED | REJECTED
  currentVersion Int      @default(1)
  createdAt      DateTime @default(now())

  versions             CreativeVersion[]
  assets               Asset[]
  contentCalendarItems ContentCalendarItem[]
  videoBrief           VideoBrief?

  @@map("creatives")
}

// ---------------------------------------------------------------------------
// AI Video Studio (Section 11.1). Pre-production planning for a video
// creative — concept, hook, storyboard, script, shot plan, voice-over
// copy, subtitle/caption copy, edit instructions, music/asset notes, and
// platform variants. Versioned the same way Brand DNA is (Section 5):
// a save always inserts a new VideoBriefVersion rather than mutating the
// latest one, "so historical creative can be evaluated against the plan
// active when it was made." The eventual final video file, its approval,
// and its publishing all go through the existing Creative/CreativeVersion/
// Approval pipeline (Section 15.1) — this model is 1:1 with a Creative
// and only covers the planning stage, not a parallel approval flow.
model VideoBrief {
  id             String   @id @default(uuid())
  creativeId     String   @unique
  creative       Creative @relation(fields: [creativeId], references: [id])
  currentVersion Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  versions VideoBriefVersion[]

  @@map("video_briefs")
}

model VideoBriefVersion {
  id               String     @id @default(uuid())
  videoBriefId     String
  videoBrief       VideoBrief @relation(fields: [videoBriefId], references: [id])
  version          Int
  concept          String?
  hook             String?
  storyboardNotes  String?
  script           String?
  voiceoverCopy    String?
  captionCopy      String?
  editInstructions String?
  musicNotes       String?
  platformVariants String? // JSON array, e.g. ["9:16","1:1","16:9"]
  createdAt        DateTime   @default(now())
  createdBy        String? // Membership id

  @@unique([videoBriefId, version])
  @@map("video_brief_versions")
}

// ---------------------------------------------------------------------------
// Photography / Production Module (Section 11.2): shoot schedule,
// locations, contacts, crew, roles, equipment, permits/requirements, call
// sheet, shot list, product list, references, status. Kept as one table
// with JSON columns for the list-shaped fields (crew/equipment/shot
// list/product list/references) rather than a table per list — same
// pragmatic choice already made for Client.services and
// BrandProfileVersion's colors/fonts/patterns; promote to real tables
// if/when this needs relational querying (e.g. "find every shoot needing
// a specific crew member").
model Shoot {
  id             String    @id @default(uuid())
  clientId       String
  client         Client    @relation(fields: [clientId], references: [id])
  projectId      String?
  project        Project?  @relation(fields: [projectId], references: [id])
  title          String
  status         String    @default("PLANNED") // PLANNED | CONFIRMED | COMPLETED | CANCELED
  scheduledAt    DateTime?
  location       String?
  crew           String? // JSON: [{ name, role, contact }]
  equipment      String? // JSON array of strings
  permits        String? // JSON array of strings
  callSheetNotes String?
  shotList       String? // JSON: [{ description, status }]
  productList    String? // JSON array of strings
  references     String? // JSON array of strings
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([clientId])
  @@map("shoots")
}

model CreativeVersion {
  id         String   @id @default(uuid())
  creativeId String
  creative   Creative @relation(fields: [creativeId], references: [id])
  version    Int
  assetId    String?
  asset      Asset?   @relation(fields: [assetId], references: [id])
  notes      String?
  createdAt  DateTime @default(now())

  approvals           Approval[]
  qualityCheckResults QualityCheckResult[]

  @@map("creative_versions")
}

model Approval {
  id                String          @id @default(uuid())
  creativeVersionId String
  creativeVersion   CreativeVersion @relation(fields: [creativeVersionId], references: [id])
  decision          String // requested | changes_requested | approved | superseded | canceled (Section 15.1)
  comment           String?
  decidedBy         String?
  createdAt         DateTime        @default(now())

  @@map("approvals")
}

// Quality Control (Section 5: "Quality Control checks outputs for brand
// consistency, spelling/language, required information, dimensions/
// specifications, and obvious inconsistencies before client review";
// Section 6.1/7 name this "Quality Control AI" in the orchestrated flow).
// Run automatically by requestApproval — see qc-service.ts for what each
// check actually does and the explicit scope boundary (deterministic
// rule checks against Brand DNA + platform dimension specs, not an LLM
// judgment call — no AI Foundation wiring exists yet for that, Phase 3).
// Advisory, not a hard gate: a FAIL still lets the request through, but
// is impossible to miss in the UI, matching "before client review"
// rather than "instead of client review."
model QualityCheckResult {
  id                String          @id @default(uuid())
  creativeVersionId String
  creativeVersion   CreativeVersion @relation(fields: [creativeVersionId], references: [id])
  overallStatus     String // pass | warning | fail
  checks            String // JSON: [{ name, status, message }]
  createdAt         DateTime        @default(now())

  @@map("quality_check_results")
}

// ---------------------------------------------------------------------------
// Content Planning and Publishing (Section 9). This is the planning/
// scheduling layer — "content calendar with client, channel, campaign,
// content pillar, format, owner, status, due date, approval, publish
// time, and linked assets" — distinct from Section 12's due-date
// calendar (packages/db already backs that one from Task/Project/Invoice
// due dates directly). Approval itself is NOT reimplemented here: a
// content item optionally points at a Creative, which already carries
// the full Section 15.1 approval state machine — this model only tracks
// the item's own planning-stage status.
//
// `status` follows Section 9's workflow (brief -> draft -> internal
// review -> client approval when required -> scheduled/ready -> publish
// -> performance -> learning) as far as this phase can actually go:
// BRIEF | DRAFT | INTERNAL_REVIEW | CLIENT_APPROVAL | SCHEDULED |
// PUBLISHED | FAILED. "Publish" here means "marked scheduled/published in
// the plan," not an authorized connector call — real publish execution
// needs the Integration Center (Phase 4, ADR-pending: no real platform
// credentials exist yet). FAILED preserves `failureReason` for the
// "actionable alerts, preserve payload/error metadata, safe retry"
// requirement, in the one form buildable without a real connector.
model ContentCalendarItem {
  id            String      @id @default(uuid())
  clientId      String
  client        Client      @relation(fields: [clientId], references: [id])
  campaignId    String?
  campaign      Campaign?   @relation(fields: [campaignId], references: [id])
  creativeId    String?
  creative      Creative?   @relation(fields: [creativeId], references: [id])
  channel       String // e.g. instagram, tiktok, meta, email, blog
  contentPillar String?
  format        String? // e.g. reel, carousel, static, story, article
  title         String
  status        String      @default("BRIEF")
  ownerId       String?
  owner         Membership? @relation(fields: [ownerId], references: [id])
  dueDate       DateTime?
  publishAt     DateTime?
  failureReason String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([clientId])
  @@map("content_calendar_items")
}

// Files & Smart Asset Manager (Section 14). `storageKey` is the
// backend-specific reference (see apps/web/src/lib/storage — a local
// filesystem adapter today, S3-compatible in production per ADR-005);
// application code should never construct a public URL from it directly,
// always go through the storage adapter's signed-URL method so swapping
// backends doesn't require touching every call site. Every asset is
// organization-scoped (and usually client-scoped) so authorization can
// filter at the query layer like everything else in this schema.
model Asset {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  clientId       String?
  client         Client?      @relation(fields: [clientId], references: [id])
  projectId      String?
  project        Project?     @relation(fields: [projectId], references: [id])
  taskId         String?
  task           Task?        @relation(fields: [taskId], references: [id])
  creativeId     String?
  creative       Creative?    @relation(fields: [creativeId], references: [id])
  type           String // image | video | document | logo | font
  filename       String
  contentType    String?
  sizeBytes      Int?
  checksum       String? // sha256 of the file content — integrity + de-dupe
  storageKey     String // backend-specific key/path
  status         String       @default("AVAILABLE") // PENDING_SCAN | AVAILABLE | REJECTED — see ADR-005 for why virus scanning isn't wired to this yet
  version        Int          @default(1)
  uploadedById   String?
  uploadedBy     Membership?  @relation(fields: [uploadedById], references: [id])
  createdAt      DateTime     @default(now())

  creativeVersions CreativeVersion[]

  @@index([organizationId])
  @@index([clientId])
  @@index([taskId])
  @@map("assets")
}

// ---------------------------------------------------------------------------
// Finance (Section 16)
// ---------------------------------------------------------------------------

model Invoice {
  id          String    @id @default(uuid())
  clientId    String
  client      Client    @relation(fields: [clientId], references: [id])
  // Optional: attributes this invoice to a specific project for
  // project-level profitability (Section 4.2/16). Null means the
  // invoice isn't tagged to a project — reported as "unassigned"
  // rather than guessed at (see docs/specs/profitability.md).
  projectId   String?
  project     Project?  @relation(fields: [projectId], references: [id])
  amountCents Int
  currency    String    @default("USD")
  status      String    @default("DRAFT") // DRAFT | SENT | PAID | OVERDUE | FAILED
  issuedAt    DateTime  @default(now())
  dueAt       DateTime?
  paidAt      DateTime?

  @@map("invoices")
}

model Expense {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  // Optional: attributes this cost to a specific client for profitability
  // reporting (Section 4.2/16). Null means an org-wide overhead cost
  // (software, general contractors) that isn't attributable to one
  // client — reported separately, never guessed at or evenly split
  // across clients.
  clientId       String?
  client         Client?      @relation(fields: [clientId], references: [id])
  // Optional: attributes this cost to a specific project within the
  // client for project-level profitability (Section 4.2/16). Only
  // meaningful alongside a clientId — a project belongs to one client,
  // so a project-tagged expense is implicitly client-tagged too (the
  // service layer enforces this, not the schema).
  projectId      String?
  project        Project?     @relation(fields: [projectId], references: [id])
  // Optional: attributes this cost to a specific campaign within the
  // project for campaign-level profitability (Section 4.2/16 Phase 5:
  // "reconciled actual spend," not just Campaign.budgetCents's manual
  // estimate). Only meaningful alongside a projectId — a campaign
  // belongs to one project (and that project to one client), so a
  // campaign-tagged expense is implicitly project- and client-tagged
  // too (the service layer enforces this, not the schema).
  campaignId     String?
  campaign       Campaign?    @relation(fields: [campaignId], references: [id])
  category       String
  amountCents    Int
  description    String?
  incurredAt     DateTime     @default(now())

  @@index([clientId])
  @@index([projectId])
  @@index([campaignId])
  @@map("expenses")
}

// ---------------------------------------------------------------------------
// Meetings (Section 13)
// ---------------------------------------------------------------------------

model Meeting {
  id         String   @id @default(uuid())
  clientId   String?
  client     Client?  @relation(fields: [clientId], references: [id])
  title      String
  notes      String?
  decisions  String? // JSON
  followUps  String? // JSON
  occurredAt DateTime @default(now())

  attendees MeetingAttendee[]

  @@map("meetings")
}

model MeetingAttendee {
  id        String  @id @default(uuid())
  meetingId String
  meeting   Meeting @relation(fields: [meetingId], references: [id])
  userId    String
  user      User    @relation(fields: [userId], references: [id])

  @@map("meeting_attendees")
}

// ---------------------------------------------------------------------------
// Cedar Brain (Section 6-7): every command logged for Agency Memory.
// ---------------------------------------------------------------------------

// Section 6.3 AI Supervisor: "Track agent/model success rate, evaluation
// score, latency, cost, retries, tool failures, hallucination/error
// reports, and user corrections." Every field below is populated from a
// real, measured value at request time (see ai-supervisor-service.ts /
// docs/specs/ai-supervisor.md for exactly which sub-signals this covers
// and which — evaluation score, retries, tool failures — have no real
// data source yet and are not faked).
model CedarBrainRequest {
  id                    String      @id @default(uuid())
  organizationId        String
  prompt                String
  routedAgents          String // JSON array
  response              String? // JSON
  clientId              String?
  mode                  String // "live" | "stub"
  modelName             String? // null for stub mode — no model was actually called
  promptVersion         String // manually bumped constant in cedar-brain.ts when the system prompt changes
  latencyMs             Int
  success               Boolean
  errorMessage          String?
  inputTokens           Int? // from the Anthropic response's usage field — null for stub mode
  outputTokens          Int?
  flaggedIncorrect      Boolean     @default(false)
  flaggedAt             DateTime?
  flaggedByMembershipId String?
  flaggedByMembership   Membership? @relation(fields: [flaggedByMembershipId], references: [id])
  createdAt             DateTime    @default(now())

  @@index([organizationId, createdAt])
  @@map("cedar_brain_requests")
}

// ---------------------------------------------------------------------------
// AI Evaluation Harness (Section 6.3/33): a real, deterministic regression
// suite for Cedar Brain's routing logic (routeToAgents in cedar-brain.ts).
// Not organization-scoped — the routing logic is shared code, identical for
// every organization, so a run's pass/fail is a system-level engineering
// signal (like a build status), not tenant data. See
// docs/specs/ai-eval-harness.md for what this does and does not cover.
model AiEvalRun {
  id          String   @id @default(uuid())
  suite       String // e.g. "cedar-brain-routing"
  totalCases  Int
  passedCases Int
  createdAt   DateTime @default(now())

  results AiEvalResult[]

  @@index([suite, createdAt])
  @@map("ai_eval_runs")
}

model AiEvalResult {
  id        String    @id @default(uuid())
  evalRunId String
  evalRun   AiEvalRun @relation(fields: [evalRunId], references: [id])
  caseName  String
  input     String
  expected  String // JSON
  actual    String // JSON
  passed    Boolean

  @@map("ai_eval_results")
}

// ---------------------------------------------------------------------------
// AI Budget Governance (Section 33: "route tasks to the least expensive
// model... budget enforcement"). One row per organization, created only
// when an owner/admin explicitly sets a limit — no default limit is ever
// fabricated, so an organization that never configures one has
// unrestricted live Cedar Brain usage, exactly as before this existed.
// See docs/specs/ai-budget-governance.md.
model AiBudget {
  id                String       @id @default(uuid())
  organizationId    String       @unique
  organization      Organization @relation(fields: [organizationId], references: [id])
  monthlyTokenLimit Int // total input+output tokens allowed per calendar month
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@map("ai_budgets")
}

// ---------------------------------------------------------------------------
// Cedar Prompt Version Registry (Section 33) — an append-only, auto-
// captured audit trail of what each CEDAR_BRAIN_PROMPT_VERSION label
// actually said, not just the label itself. System-wide (no
// organizationId): the prompt template is shared code, identical for
// every organization, so this is a build-artifact-style audit log, not
// tenant data — and deliberately read-only from the app (no API route
// or UI writes it), since a mutable prompt editor any org's admin could
// reach would let one organization silently change Cedar Brain's
// behavior for every other organization. See
// docs/specs/cedar-prompt-registry.md.
model CedarPromptSnapshot {
  id            String   @id @default(uuid())
  promptVersion String   @unique
  template      String
  recordedAt    DateTime @default(now())

  @@map("cedar_prompt_snapshots")
}

// ---------------------------------------------------------------------------
// Notifications and Alerts (Section 30): "In-app notification center with
// severity, category, client/resource, action, read/acknowledged state."
// Written by packages/events' notifications.ts — the same append-then-read
// pattern as AuditEvent, but user-facing and mutable (read/acknowledged
// state changes in place, unlike the audit log).
// ---------------------------------------------------------------------------

model Notification {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  membershipId   String
  membership     Membership   @relation(fields: [membershipId], references: [id])
  severity       String // INFO | WARNING | CRITICAL
  category       String // e.g. approval_requested, quality_control_failed, content_publish_failed, task_overdue, project_overdue, content_overdue
  clientId       String?
  client         Client?      @relation(fields: [clientId], references: [id])
  resourceType   String?
  resourceId     String?
  title          String
  body           String?
  actionUrl      String?
  status         String       @default("UNREAD") // UNREAD | READ | ACKNOWLEDGED
  createdAt      DateTime     @default(now())
  readAt         DateTime?

  @@index([membershipId, status])
  @@index([resourceType, resourceId, category])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// Integration Center (Section 17.1/34, Phase 4): "Connection dashboard shows
// connected/not connected, scopes, token expiry, last sync, next retry,
// errors, degraded status, and required user action." The one real
// provider today is "generic_webhook" (packages/connectors'
// GenericWebhookAdapter) — a signed inbound webhook receiver that needs no
// third-party OAuth app registration. Meta/TikTok/Google/WhatsApp adapters
// are not built (see docs/specs/integration-center.md): they need real
// OAuth credentials this environment can't obtain.
// ---------------------------------------------------------------------------

model Connection {
  id                     String       @id @default(uuid())
  organizationId         String
  organization           Organization @relation(fields: [organizationId], references: [id])
  provider               String // "generic_webhook" is the only real provider implemented so far
  name                   String // user-given label, e.g. "Zapier — lead form"
  status                 String       @default("CONNECTED") // CONNECTED | DISCONNECTED | DEGRADED | ERROR
  scopes                 String // JSON array — empty for generic_webhook, real for a future OAuth provider
  signingSecretEncrypted String // AES-256-GCM, same encryptSecret/decryptSecret primitive as MFA (packages/auth)
  lastEventAt            DateTime?
  eventCount             Int          @default(0)
  createdAt              DateTime     @default(now())
  createdByMembershipId  String?
  createdByMembership    Membership?  @relation(fields: [createdByMembershipId], references: [id])

  events ConnectionEvent[]

  @@index([organizationId])
  @@map("connections")
}

model ConnectionEvent {
  id             String     @id @default(uuid())
  connectionId   String
  connection     Connection @relation(fields: [connectionId], references: [id])
  idempotencyKey String // dedupes a retried webhook delivery (Section 17.1)
  eventType      String?
  payload        String // JSON — bounded, retained for debugging/audit (Section 34)
  receivedAt     DateTime   @default(now())

  @@unique([connectionId, idempotencyKey])
  @@index([connectionId, receivedAt])
  @@map("connection_events")
}
