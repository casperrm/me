// Cedar Point OS — core data model.
//
// This schema is the shared backbone every module reads and writes against
// (Section 33, Knowledge Graph). Modules that don't exist yet (Ads
// integrations, Localization, Video Studio, ...) attach to these same
// entities rather than inventing parallel client/project records, so the
// system stays one graph instead of ten disconnected tools.
//
// Dev uses SQLite for zero-config setup. Swap the datasource to
// postgresql and point DATABASE_URL at a real instance for production —
// no model changes required.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Organization & Access (Section 29-30: invite-only, roles, audit trail)
// ---------------------------------------------------------------------------

// Role is a plain String (not a Prisma enum) because the SQLite connector
// used in dev doesn't support native enums; valid values: OWNER | ADMIN |
// MEMBER | CLIENT. Re-introduce a real enum once running on Postgres.

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  users     User[]
  clients   Client[]
  expenses  Expense[]
  auditLogs AuditLog[]
}

model User {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  email          String       @unique
  name           String
  role           String       @default("MEMBER")
  createdAt      DateTime     @default(now())

  assignedTasks  Task[]
  meetings       MeetingAttendee[]
  auditLogs      AuditLog[]
}

// Every important action is attributable (Section 30).
model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  userId         String?
  user           User?        @relation(fields: [userId], references: [id])
  action         String
  entityType     String
  entityId       String
  metadata       String? // JSON blob
  createdAt      DateTime     @default(now())

  @@index([organizationId, entityType, entityId])
}

// ---------------------------------------------------------------------------
// Client Management + Brand DNA (Sections 2-3)
// ---------------------------------------------------------------------------

model Client {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  companyName    String
  industry       String?
  status         String       @default("ACTIVE") // PROSPECT | ACTIVE | PAUSED | CHURNED
  services       String // JSON array of service names, e.g. ["Social", "Ads", "Video"]
  primaryContactName  String?
  primaryContactEmail String?
  connectedAccounts   String? // JSON: [{ platform, accountId, status }]
  createdAt      DateTime     @default(now())

  brandDNA       BrandDNA?
  projects       Project[]
  invoices       Invoice[]
  notes          Note[]
  meetings       Meeting[]
  timelineEvents ClientTimelineEvent[]
  healthScores   ClientHealthScore[]
}

// Section 3: what the AI should already know before it's told again.
model BrandDNA {
  id              String   @id @default(cuid())
  clientId        String   @unique
  client          Client   @relation(fields: [clientId], references: [id])
  colors          String? // JSON: [{ name, hex }]
  fonts           String? // JSON: [{ role, family }]
  logoAssetIds    String? // JSON array of Asset ids
  toneOfVoice     String?
  visualStyle     String?
  targetAudience  String?
  products        String? // JSON array
  approvedPatterns String? // JSON: design/creative patterns the client has approved
  rejectedPatterns String? // JSON: design/creative patterns the client has rejected
  updatedAt       DateTime @updatedAt
}

// Section 2: full relationship history, first contact through renewal.
model ClientTimelineEvent {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id])
  type      String // e.g. "first_contact", "project_started", "payment", "approval", "renewal"
  summary   String
  metadata  String? // JSON
  occurredAt DateTime @default(now())

  @@index([clientId, occurredAt])
}

// Section 20: client health scoring, tracked over time so trends are visible.
model ClientHealthScore {
  id         String   @id @default(cuid())
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id])
  score      Int // 0-100
  factors    String? // JSON: { relationship, performance, delays, approvals, payments, communication }
  computedAt DateTime @default(now())
}

model Note {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id])
  body      String
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Projects, Tasks, Campaigns, Creatives (Sections 10-13, 25)
// ---------------------------------------------------------------------------

model Project {
  id          String        @id @default(cuid())
  clientId    String
  client      Client        @relation(fields: [clientId], references: [id])
  name        String
  status      String        @default("PLANNING") // PLANNING | IN_PROGRESS | IN_REVIEW | DELIVERED | ARCHIVED
  dueDate     DateTime?
  createdAt   DateTime      @default(now())

  tasks       Task[]
  campaigns   Campaign[]
  assets      Asset[]
}

model Task {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id])
  title       String
  status      String    @default("todo") // todo | in_progress | done
  assigneeId  String?
  assignee    User?     @relation(fields: [assigneeId], references: [id])
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
}

// Section 13: campaign & ads management shell. Platform sync fields are
// nullable placeholders — the Integration Center (Section 14) populates
// them once a real Meta/TikTok/Google connection exists.
model Campaign {
  id             String         @id @default(cuid())
  projectId      String
  project        Project        @relation(fields: [projectId], references: [id])
  name           String
  objective      String?
  status         String         @default("DRAFT") // DRAFT | PENDING_APPROVAL | ACTIVE | PAUSED | COMPLETED
  platform       String? // meta | tiktok | google | ...
  externalId     String? // id on the ad platform once synced
  budgetCents    Int?
  kpis           String? // JSON: { impressions, clicks, conversions, spend, ... }
  createdAt      DateTime       @default(now())

  creatives      Creative[]
}

// Sections 9-11, 22: one creative concept, versioned, with an approval trail.
model Creative {
  id          String         @id @default(cuid())
  campaignId  String
  campaign    Campaign       @relation(fields: [campaignId], references: [id])
  type        String // image | video | carousel | reel | story | copy
  platform    String? // instagram_feed | instagram_story | tiktok | facebook | whatsapp | ...
  status      String         @default("DRAFT") // DRAFT | PENDING_APPROVAL | APPROVED | REJECTED
  currentVersion Int         @default(1)
  createdAt   DateTime       @default(now())

  versions    CreativeVersion[]
  assets      Asset[]
}

model CreativeVersion {
  id          String   @id @default(cuid())
  creativeId  String
  creative    Creative @relation(fields: [creativeId], references: [id])
  version     Int
  assetId     String?
  notes       String?
  createdAt   DateTime @default(now())

  approvals   Approval[]
}

// Section 22: approval/revision system shared by creatives, campaigns, etc.
model Approval {
  id                String          @id @default(cuid())
  creativeVersionId String
  creativeVersion   CreativeVersion @relation(fields: [creativeVersionId], references: [id])
  decision          String // approved | rejected | comment
  comment           String?
  decidedBy         String? // client contact name, until Client Portal auth exists
  createdAt         DateTime        @default(now())
}

// ---------------------------------------------------------------------------
// Files & Assets (Section 26)
// ---------------------------------------------------------------------------

model Asset {
  id          String    @id @default(cuid())
  projectId   String?
  project     Project?  @relation(fields: [projectId], references: [id])
  creativeId  String?
  creative    Creative? @relation(fields: [creativeId], references: [id])
  type        String // image | video | document | logo | font
  url         String
  filename    String
  sizeBytes   Int?
  createdAt   DateTime  @default(now())
}

// ---------------------------------------------------------------------------
// Finance (Sections 16-17)
// ---------------------------------------------------------------------------

model Invoice {
  id          String        @id @default(cuid())
  clientId    String
  client      Client        @relation(fields: [clientId], references: [id])
  amountCents Int
  currency    String        @default("USD")
  status      String        @default("DRAFT") // DRAFT | SENT | PAID | OVERDUE | FAILED
  issuedAt    DateTime      @default(now())
  dueAt       DateTime?
  paidAt      DateTime?
}

model Expense {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  category       String
  amountCents    Int
  description    String?
  incurredAt     DateTime     @default(now())
}

// ---------------------------------------------------------------------------
// Meetings (Section 27)
// ---------------------------------------------------------------------------

model Meeting {
  id        String   @id @default(cuid())
  clientId  String?
  client    Client?  @relation(fields: [clientId], references: [id])
  title     String
  notes     String?
  decisions String? // JSON array of extracted decisions
  followUps String? // JSON array of extracted follow-ups
  occurredAt DateTime @default(now())

  attendees MeetingAttendee[]
}

model MeetingAttendee {
  id        String  @id @default(cuid())
  meetingId String
  meeting   Meeting @relation(fields: [meetingId], references: [id])
  userId    String
  user      User    @relation(fields: [userId], references: [id])
}

// ---------------------------------------------------------------------------
// Cedar Brain (Section 4): every request routed through the Command Center
// is logged so Agency Memory (Section 5) has something to learn from.
// ---------------------------------------------------------------------------

model CedarBrainRequest {
  id           String   @id @default(cuid())
  prompt       String
  routedAgents String // JSON array, e.g. ["marketing", "design", "quality_control"]
  response     String? // JSON
  clientId     String?
  createdAt    DateTime @default(now())
}
