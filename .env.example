# Database (SQLite by default, swap for Postgres in production: postgresql://user:pass@host:5432/db)
DATABASE_URL="file:./dev.db"

# Secret used to sign login session tokens - generate with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"

# Anthropic API key that powers the Cedar Point Brain assistant.
# Get one at https://console.anthropic.com/ - without it the Brain page
# still loads but explains that it isn't configured yet.
ANTHROPIC_API_KEY=""
