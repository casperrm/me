# Local SQLite by default. Swap to a Postgres URL in production
# (postgresql://user:password@host:5432/cedarpoint) — the schema is
# provider-agnostic aside from this line.
DATABASE_URL="file:./dev.db"

# Optional: enables real Cedar Brain responses via the Anthropic API.
# Without this set, the Command Center falls back to a deterministic
# stub so the UI/orchestration flow can still be exercised end-to-end.
ANTHROPIC_API_KEY=
