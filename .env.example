# Shared across apps/web, apps/api, apps/worker, and packages/db.
# Copy to .env at the repo root: cp .env.example .env

# PostgreSQL is the canonical database (Bible Section 27).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cedarpoint"

# Redis backs the queue used by apps/worker (Bible Section 25.2) and, later,
# rate limiting / caching. Interim choice — see docs/adr/0004-queue-and-outbox-strategy.md.
REDIS_URL="redis://localhost:6379"

# Session signing secret (32+ random bytes). Generate with: openssl rand -hex 32
SESSION_SECRET="replace-with-a-random-64-char-hex-string-before-any-real-deployment"


# Optional: enables live Cedar Brain responses (Section 6) instead of the
# deterministic stub used when this is unset.
ANTHROPIC_API_KEY=
